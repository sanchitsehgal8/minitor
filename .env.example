# ---------------------------------------------------------------------------
# MiniTor environment. Copy to `.env` and fill in NEXTAUTH_SECRET:
#
#   cp .env.example .env
#   npm run db:setup
#
# `.env` is git-ignored; this template is the file that is committed.
# ---------------------------------------------------------------------------

# Database connection string.
#
# Local development uses SQLite. The path is resolved RELATIVE TO THE SCHEMA
# FILE (database/schema.prisma), so `file:./dev.db` creates database/dev.db.
DATABASE_URL="file:./dev.db"

# Hosted (Vercel/Supabase/Neon) uses Postgres instead. Prisma requires the
# datasource provider to be a literal, so switching also means editing
# `provider` in database/schema.prisma to "postgresql" — see the README.
# DATABASE_URL="postgresql://user:password@host:5432/minitor?sslmode=require"

# Signing key for NextAuth's JWT session cookies. REQUIRED — auth fails without
# it in production. Generate a real one, never ship this placeholder:
#
#   openssl rand -base64 32
NEXTAUTH_SECRET="replace-me-run-openssl-rand-base64-32"

# The canonical origin NextAuth builds callback URLs from. Must match the port
# the app is actually served on, and the deployment URL in production.
NEXTAUTH_URL="http://localhost:3000"
