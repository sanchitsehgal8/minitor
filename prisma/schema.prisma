// Local dev uses SQLite. Prisma requires the provider to be a literal, so
// deploying to Postgres/Supabase means changing `provider` below to
// "postgresql" and pointing DATABASE_URL at that database — see README.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  createdAt    DateTime       @default(now())
  bookmarks    Bookmark[]
  history      HistoryEntry[]
  scans        ScanRecord[]
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  url       String
  title     String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One bookmark per URL per user; the UI toggles rather than duplicates.
  @@unique([userId, url])
  @@index([userId, createdAt])
}

model HistoryEntry {
  id        String   @id @default(cuid())
  userId    String
  url       String
  title     String
  visitedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, visitedAt])
}

// A stored website privacy scan.
//
// `payload` holds the full ScanResult as JSON. SQLite has no JSON column type,
// so it is stored as text and parsed on read. Normalising requests and cookies
// into their own tables would add several joins for data that is only ever read
// back as one whole report.
model ScanRecord {
  id            String   @id @default(cuid())
  userId        String
  domain        String
  url           String
  privacyScore  Int
  securityScore Int
  // Whether the user asked to keep re-scanning this site (spec section 15).
  monitored     Boolean  @default(false)
  payload       String
  scannedAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, scannedAt])
  @@index([userId, domain])
}
