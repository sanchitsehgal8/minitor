{
  "name": "minitor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate --schema=database/schema.prisma && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "prisma db push --schema=database/schema.prisma",
    "db:generate": "prisma generate --schema=database/schema.prisma",
    "db:seed": "vite-node --config vitest.config.ts database/seed.ts",
    "db:setup": "prisma db push --schema=database/schema.prisma && vite-node --config vitest.config.ts database/seed.ts",
    "db:studio": "prisma studio --schema=database/schema.prisma",
    "postinstall": "prisma generate --schema=database/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "bcryptjs": "2.4.3",
    "framer-motion": "11.11.17",
    "next": "14.2.18",
    "next-auth": "4.24.10",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "20.17.6",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.18",
    "postcss": "8.4.49",
    "prisma": "5.22.0",
    "tailwindcss": "3.4.15",
    "typescript": "5.6.3",
    "vitest": "2.1.5"
  }
}
